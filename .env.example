PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/prediction-app
JWT_SECRET=your_secret_key

# Bootstrap admin (always approved; can sign in immediately)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password

# Where approval links in emails point (must reach this server from the admin's browser)
PUBLIC_API_URL=http://localhost:5000

# Who receives new registration emails (defaults to ADMIN_EMAIL if unset)
# ADMIN_NOTIFICATION_EMAIL=admin@example.com

# SMTP — required to send approval emails (install nodemailer: npm install)
# Gmail configuration:
# 1. Enable 2-Step Verification in Google Account
# 2. Generate a 16-character App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
# Alternatively: SMTP_SERVICE=gmail
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM="RoboFly <your_email@gmail.com>"

